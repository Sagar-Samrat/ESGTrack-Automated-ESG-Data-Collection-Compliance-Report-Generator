# ==========================================
# ESGTrack Environment Configuration
# ==========================================

# Application
APP_NAME=ESGTrack
APP_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security & Authentication
# Generate a secure key in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=super-secret-esgtrack-production-jwt-key-change-in-prod-2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# If MongoDB is unavailable locally, ESGTrack automatically falls back to an in-memory/mock engine
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=esgtrack_db

# Artificial Intelligence (Google Gemini)
# Leave empty or set to 'mock' to use high-fidelity deterministic offline AI report generator
GEMINI_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# File Storage
UPLOAD_DIR=./uploads
REPORTS_DIR=./generated_reports
MAX_UPLOAD_SIZE_MB=50

